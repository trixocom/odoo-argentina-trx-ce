<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ar_trx_pos_edi.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <!-- Ocultar "Need an invoice?" cuando ya hay CAE -->
        <xpath expr="//img[@id='posqrcode']/../.." position="attributes">
            <attribute name="t-if" add="!arHasCae" separator=" and "/>
        </xpath>

        <!-- Encabezado de columnas (estilo v16) -->
        <xpath expr="//OrderDisplay" position="before">
            <div class="trx-recline-head d-flex justify-content-between fw-bolder pt-2">
                <span>CANT. x PRECIO UNIT.</span>
                <span>IMPORTE</span>
            </div>
        </xpath>

        <!-- Linea en 2 renglones: arriba cant x precio unit. + importe; abajo descripcion -->
        <xpath expr="//Orderline" position="replace">
            <t t-set="q" t-value="line.getQuantityStr()"/>
            <div class="orderline trx-recline">
                <div class="trx-recline-top d-flex justify-content-between fw-bolder">
                    <span>
                        <t t-esc="q.unitPart"/><t t-if="q.decimalPart"><t t-esc="q.decimalPoint"/><t t-esc="q.decimalPart"/></t>
                        x <t t-out="line.currencyDisplayPriceUnit"/>
                    </span>
                    <span class="font-monospace" t-out="line.currencyDisplayPrice"/>
                </div>
                <div class="trx-recline-desc text-break">
                    <t t-if="line.product_id.default_code">[<t t-esc="line.product_id.default_code"/>] </t><t t-out="line.full_product_name"/>
                </div>
                <div t-if="line.customer_note" class="fst-italic" t-out="line.customer_note"/>
            </div>
        </xpath>

        <!-- Bloque QR + CAE RG 4291 (sin "Comprobante": el nro va arriba) -->
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <t t-if="arHasCae">
                <div class="pos-receipt-l10n-ar-cae pt-3 text-center" style="font-size: 90%;">
                    <img t-att-src="arQrDataUrl" class="m-0" style="width: 140px; height: 140px;" alt="QR AFIP RG 4291"/>
                </div>
                <div class="pos-receipt-l10n-ar-cae-info pt-1" style="font-size: 90%;">
                    <div class="d-flex">
                        <span>CAE</span>
                        <span class="ms-auto font-monospace" t-out="arInvoice.l10n_ar_afip_auth_code"/>
                    </div>
                    <div t-if="arInvoice.l10n_ar_afip_auth_code_due" class="d-flex">
                        <span>Vto. CAE</span>
                        <span class="ms-auto font-monospace" t-out="arInvoice.l10n_ar_afip_auth_code_due"/>
                    </div>
                    <div class="text-center pt-1" style="font-size: 80%;">
                        RG AFIP 4291
                    </div>
                </div>
            </t>
        </xpath>
        <!-- Datos de empresa: se mueven arriba (ver receipt_header) -->
        <xpath expr="//div[hasclass('pos-config-name')]/../.." position="replace"/>
    </t>
</templates>
